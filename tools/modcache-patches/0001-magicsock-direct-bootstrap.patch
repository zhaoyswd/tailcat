+// address with a short trust window: that is the recovery path from the wedged
+// state (no sendable candidate ⇒ handshake responses dropped ⇒ no traffic that
+// could refresh anything), and it makes the first response leave over the path
+// the request actually came in on.
+func (de *endpoint) noteDirectCandidate(src epAddr, now mono.Time) {
+	if !src.isDirect() {
