+// PATCH(tier): bounds for endpoints synthesized from inbound handshakes.
+const (
+	// provisionalEndpointMax caps how many unknown-key endpoints we hold at
+	// once. At the cap, new unknown-key handshakes are dropped (the behaviour
+	// before this patch) instead of letting anyone who has the address grow
+	// the table without bound.
+	provisionalEndpointMax = 32
+
+	// provisionalEndpointIdle is how long a provisional endpoint that received
+	// no packets survives. Live peers keep refreshing it; one-shot forged
+	// handshakes age out.
+	provisionalEndpointIdle = 10 * time.Minute
+)
+
+// SetBootstrapCandidates enables using known candidate endpoints as a UDP
+// destination before any path has been verified, so the first WireGuard
+// handshake can go direct instead of being relayed through DERP. Candidates
+// come from the caller (for tailcat: endpoint hints carried in the address and
+// endpoints learned from previous sessions). DERP is still used when it is
+// reachable; this only removes the requirement that it be reachable before a
+// direct path can be attempted. Defaults to false.
+func (c *Conn) SetBootstrapCandidates(v bool) {
+	c.bootstrapCandidates.Store(v)
+}
+
+// SetAcceptProvisionalInitiators enables answering WireGuard handshakes from
+// peer keys that are not in the network map. Without a control plane (tailcat
+// has none) an exit node learns its clients from this handshake, so this is
+// what makes a direct-only (no DERP) first connection possible.
+//
+// The cryptographic admission control is unchanged: the handshake still has to
+// verify the pre-shared key, and a peer only becomes routable for traffic that
+// same handshake authenticated. What changes is that an unknown sender can make
+// this node allocate a (bounded, idle-expired) endpoint and answer it. Treat the
+// tailcat address as a secret, as before. Defaults to false.
+func (c *Conn) SetAcceptProvisionalInitiators(v bool) {
+	c.acceptProvisionalInitiators.Store(v)
+	if !v {
+		c.dropProvisionalEndpoints()
+	}
+}
+
+// dropProvisionalEndpoints removes every synthesized endpoint.
+func (c *Conn) dropProvisionalEndpoints() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for k := range c.provisionalPeers {
+		if ep, ok := c.peerMap.endpointForNodeKey(k); ok && ep.provisional {
+			c.peerMap.deleteEndpoint(ep)
+		}
+		delete(c.provisionalPeers, k)
+	}
 }
 
+// provisionalNodeID returns a node ID for a synthesized endpoint. It must be
+// inheritedPathState is the path information a provisional endpoint carries —
+// the addresses we have actually received packets from, and the address we
+// were last able to reach — captured before the endpoint is replaced by the
+// network map version of the same peer.
+type inheritedPathState struct {
+	addrs []netip.AddrPort
+	best  addrQuality
+}
+
+// takeProvisionalPathState snapshots ep's learned path. The endpoint must be
+// withdrawn from the peer map by the caller immediately after (the snapshot is
+// what survives).
+func takeProvisionalPathState(ep *endpoint) *inheritedPathState {
+	st := &inheritedPathState{}
+	ep.mu.Lock()
+	for ap := range ep.endpointState {
+		st.addrs = append(st.addrs, ap)
+	}
+	st.best = ep.bestAddr
+	ep.mu.Unlock()
+	return st
+}
+
+// provisionalNodeID returns a node ID for a synthesized endpoint. It must be
+// non-zero ([peerMap.upsertEndpoint] rejects zero) and must not collide with
+// the small IDs a control plane hands out, so it lives in a high range derived
+// from the node key.
+func provisionalNodeID(pubKey key.NodePublic) tailcfg.NodeID {
+	raw := pubKey.Raw32()
+	var v uint64
+	for i := 0; i < 8; i++ {
+		v = v<<8 | uint64(raw[i])
+	}
+	return tailcfg.NodeID(v>>16) | (tailcfg.NodeID(1) << 62)
+}
