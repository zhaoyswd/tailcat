+// upsertProvisionalEndpointLocked returns the endpoint for pubKey, creating a
+// synthesized one (with src recorded as its only reachable address) if this
+// node has never heard of pubKey. Returns ok == false when the bound is hit, in
+// which case the caller must drop the packet.
+//
+// c.mu must be held. The returned endpoint, if any, is safe to use as usual.
+func (c *Conn) upsertProvisionalEndpointLocked(pubKey key.NodePublic, src epAddr) (*endpoint, bool) {
+	now := mono.Now()
+	if ep, ok := c.peerMap.endpointForNodeKey(pubKey); ok {
+		if !ep.provisional {
+			// Raced with a network map update that created the real endpoint.
+			return ep, true
+		}
+		if c.provisionalPeers == nil {
+			c.provisionalPeers = make(map[key.NodePublic]mono.Time)
+		}
+		c.provisionalPeers[pubKey] = now
+		return ep, true
+	}
+
+	// Evict idle entries first; nothing else prunes these (they are not in the
+	// network map, so that cleanup deliberately skips them).
+	for k, seen := range c.provisionalPeers {
+		if now.Sub(seen) < provisionalEndpointIdle {
+			continue
+		}
+		if ep, ok := c.peerMap.endpointForNodeKey(k); ok && ep.provisional {
+			c.peerMap.deleteEndpoint(ep)
+		}
+		delete(c.provisionalPeers, k)
+	}
+	if len(c.provisionalPeers) >= provisionalEndpointMax {
+		c.logf("magicsock: provisional peers at cap (%d); dropping handshake from %v",
+			provisionalEndpointMax, pubKey.ShortString())
+		return nil, false
+	}
+
+	ep := &endpoint{
+		c:               c,
+		nodeID:          provisionalNodeID(pubKey),
+		publicKey:       pubKey,
+		publicKeyHex:    pubKey.UntypedHexString(),
+		sentPing:        map[stun.TxID]sentPing{},
+		endpointState:   map[netip.AddrPort]*endpointState{},
+		isWireguardOnly: true,
+		provisional:     true,
+	}
+	// nodeAddr stays zero: we do not know the peer's tailnet address (the
+	// caller's peer config derives that). It is only used for logging and for
+	// wireguard's handshake rate limiter.
+	//
+	// disco must be non-nil: [endpoint.updateFromNode] and the logging helpers
+	// dereference it. We know nothing about this peer's disco key, so mark the
+	// (empty) TSMP key as the active one.
+	ep.disco.Store(&endpointDisco{tsmpActive: true})
+	ep.initFakeUDPAddr()
+	ep.endpointState[src.ap] = &endpointState{lastGotPing: time.Now()}
+	ep.mu.Lock()
+	ep.setBestAddrLocked(addrQuality{epAddr: src})
+	ep.bestAddrAt = now
+	ep.trustBestAddrUntil = now.Add(trustUDPAddrDuration)
+	ep.mu.Unlock()
+	c.peerMap.upsertEndpoint(ep, key.DiscoPublic{}, false)
+	if c.provisionalPeers == nil {
+		c.provisionalPeers = make(map[key.NodePublic]mono.Time)
+	}
+	c.provisionalPeers[pubKey] = now
+	c.logf("magicsock: provisional peer %v learned from %v (direct handshake, no network map)",
+		pubKey.ShortString(), src)
+	return ep, true
+}
