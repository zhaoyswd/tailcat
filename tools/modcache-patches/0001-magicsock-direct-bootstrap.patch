+func TestTierRoamingLearn(t *testing.T) {
+	c := &Conn{logf: t.Logf}
+	c.acceptProvisionalInitiators.Store(true)
+	de := tierTestEndpoint(c)
+	now := mono.Now()
+	src := epAddr{ap: netip.MustParseAddrPort("192.0.2.5:304")}
+	if !src.isDirect() {
+		t.Fatal("前置：测试地址应为直连地址")
+	}
+	de.noteRecvActivity(src, now)
+	if len(de.endpointState) != 1 || de.bestAddr.epAddr.ap != src.ap {
+		t.Fatalf("空候选时应学习源地址并设为 best：%v / %v", de.endpointState, de.bestAddr)
+	}
+
+	// 已登记的运行时条目：刷新 lastGotPing（netmap 清理按它判活，不刷新会被误删）、
+	// 清零发送失败记账（能收到包就是能收）。
+	old := time.Now().Add(-time.Hour)
+	de.endpointState[src.ap].lastGotPing = old
+	de.endpointState[src.ap].sendFails = tierSendFailLimit
+	de.noteRecvActivity(src, now)
+	if !de.endpointState[src.ap].lastGotPing.After(old) {
+		t.Fatal("已登记地址应刷新 lastGotPing")
+	}
+	if de.endpointState[src.ap].sendFails != 0 {
+		t.Fatalf("收到包即证明能收，发送失败记账应清零，got %d", de.endpointState[src.ap].sendFails)
+	}
+
+	// 同类（都是公网）且 best 新鲜：**不**抢 best，避免同一 peer 多路径来回抖。
+	same := epAddr{ap: netip.MustParseAddrPort("192.0.2.6:304")}
+	de.noteRecvActivity(same, mono.Now())
+	if de.bestAddr.epAddr.ap != src.ap {
+		t.Fatalf("同类新鲜候选不应抢 best：best=%v want %v", de.bestAddr.epAddr.ap, src.ap)
+	}
+
+	// 同 LAN 优先（②）：best 是需要 NAT 回环的公网地址时，私网来包地址接管。
+	lan := epAddr{ap: netip.MustParseAddrPort("192.168.3.12:41641")}
+	de.noteRecvActivity(lan, mono.Now())
+	if de.bestAddr.epAddr.ap != lan.ap {
+		t.Fatalf("同 LAN 候选应抢过公网 best：best=%v want %v", de.bestAddr.epAddr.ap, lan.ap)
+	}
+	// 同类（都是私网）不抖。
+	lan2 := epAddr{ap: netip.MustParseAddrPort("192.168.3.99:41641")}
+	de.noteRecvActivity(lan2, mono.Now())
+	if de.bestAddr.epAddr.ap != lan.ap {
+		t.Fatalf("同类私网候选不应抢 best：best=%v want %v", de.bestAddr.epAddr.ap, lan.ap)
+	}
+
+	// ③ best 的候选 2s 没再收到包 → 当前来包地址接管（对端换地址/换网时跟随）。
+	de.endpointState[lan.ap].lastGotPing = time.Now().Add(-3 * time.Second)
+	de.noteRecvActivity(lan2, mono.Now())
+	if de.bestAddr.epAddr.ap != lan2.ap {
+		t.Fatalf("best 陈旧时来包地址应接管：best=%v want %v", de.bestAddr.epAddr.ap, lan2.ap)
+	}
+
+	// ① best 无效 / 信任窗过期 → 无条件采纳（恢复路径，上一版语义）。
+	de.clearBestAddrLocked()
+	de.noteRecvActivity(lan, mono.Now())
+	if de.bestAddr.epAddr.ap != lan.ap {
+		t.Fatalf("best 无效时应采纳来包地址：best=%v want %v", de.bestAddr.epAddr.ap, lan.ap)
+	}
+	de.noteRecvActivity(src, mono.Now().Add(10*time.Second))
+	if de.bestAddr.epAddr.ap == lan.ap {
+		t.Fatalf("信任窗过期后应采纳来包地址：best 仍为 %v", de.bestAddr.epAddr.ap)
+	}
+
+	// netmap 来的条目（lastGotPing 为零）保持为零：它归 netmap 的 index 管理，
+	// 不能获得运行时语义（否则 peer 安静 45s 就被 sessionActiveTimeout 删掉，尽管还在 netmap 里）。
+	nmap := epAddr{ap: netip.MustParseAddrPort("192.0.2.7:304")}
+	de.endpointState[nmap.ap] = &endpointState{}
+	de.noteRecvActivity(nmap, now)
+	if !de.endpointState[nmap.ap].lastGotPing.IsZero() {
+		t.Fatal("netmap 来的条目不得获得运行时 lastGotPing")
+	}
+
+	// 非直连源（DERP 伪地址 / 带 VNI 的中继地址）不登记：写进去会把出站流量送去死路径。
+	derp := epAddr{ap: netip.MustParseAddrPort("127.3.3.40:304")}
+	if derp.isDirect() {
+		t.Fatal("前置：DERP 伪地址不应被判为直连")
+	}
+	de.noteRecvActivity(derp, now)
+	if _, ok := de.endpointState[derp.ap]; ok {
+		t.Fatal("DERP 地址不得登记为直连候选")
+	}
+
+	// 未开启 AcceptProvisionalInitiators（普通客户端 / 其它 tailscale.com 使用者）时完全不动。
+	plain := &Conn{logf: t.Logf}
+	plainEP := tierTestEndpoint(plain)
+	plainEP.noteRecvActivity(src, now)
+	if len(plainEP.endpointState) != 0 || plainEP.bestAddr.ap.IsValid() {
+		t.Fatalf("未开启时不应学习：%v / %v", plainEP.endpointState, plainEP.bestAddr)
+	}
+
+	// 上限：学到的候选不得超过 tierLearnedEndpointMax（防端口喷洒把候选表撑爆）。
+	base := netip.MustParseAddr("192.0.2.10")
+	for i := 0; i < tierLearnedEndpointMax; i++ {
+		de.noteRecvActivity(epAddr{ap: netip.AddrPortFrom(base, uint16(1000+i))}, now)
+	}
+	capped := epAddr{ap: netip.AddrPortFrom(base, 9999)}
+	de.noteRecvActivity(capped, now)
+	if _, ok := de.endpointState[capped.ap]; ok {
+		t.Fatalf("达到上限 %d 后不得再登记新候选", tierLearnedEndpointMax)
+	}
+}
