+// dropProvisionalEndpoints removes every synthesized endpoint.
+func (c *Conn) dropProvisionalEndpoints() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for k := range c.provisionalPeers {
+		if ep, ok := c.peerMap.endpointForNodeKey(k); ok && ep.provisional {
+			c.peerMap.deleteEndpoint(ep)
+		}
+		delete(c.provisionalPeers, k)
+	}
