+// tierNoHairpinAddr reports whether ap is an address a same-LAN peer can reach
+// without NAT hairpinning (RFC1918, loopback or link-local). PATCH(tier #2).
+func tierNoHairpinAddr(ap netip.AddrPort) bool {
+	a := ap.Addr()
+	return a.IsPrivate() || a.IsLoopback() || a.IsLinkLocalUnicast()
+}
+
+// tierBestRecvStale reports whether the current best address has gone quiet:
+// a runtime-learned candidate (lastGotPing non-zero, i.e. we have received
+// packets from it at some point) whose last received packet is older than
+// tierBestStaleAfter. Candidates that came from the network map (lastGotPing
+// zero) are never reported stale — they have no receive bookkeeping of their
+// own. PATCH(tier #2).
+func tierBestRecvStale(states map[netip.AddrPort]*endpointState, best netip.AddrPort, now time.Time) bool {
+	st, ok := states[best]
+	if !ok || st.lastGotPing.IsZero() {
+		return false
+	}
+	return now.Sub(st.lastGotPing) > tierBestStaleAfter
+}
