+// TestTierSendFailureBacksOffNetmapCandidate（#3）：网络地图候选摘不掉 → 进入探测退避。
+func TestTierSendFailureBacksOffNetmapCandidate(t *testing.T) {
+	c := newConn(t.Logf)
+	ep := tierTestEndpoint(c)
+	nmAddr := netip.MustParseAddrPort("203.0.113.9:41641")
+	ep.endpointState[nmAddr] = &endpointState{} // lastGotPing 为零 = 来自网络地图
+	for i := 0; i < tierSendFailLimit; i++ {
+		ep.noteSendFailure(nmAddr)
+	}
+	st, ok := ep.endpointState[nmAddr]
+	if !ok {
+		t.Fatalf("network-map candidate must not be dropped")
+	}
+	if got := st.pingInterval(); got != tierSendFailBackoff {
+		t.Fatalf("ping interval = %v, want %v", got, tierSendFailBackoff)
+	}
+	// 收到它的包 → 记账清零、探测回到常规节奏。
+	ep.noteDirectCandidate(epAddr{ap: nmAddr}, mono.Now())
+	if st.sendFails != 0 {
+		t.Fatalf("send failures must reset on receive, got %d", st.sendFails)
+	}
+	if got := st.pingInterval(); got != discoPingInterval {
+		t.Fatalf("ping interval after success = %v, want %v", got, discoPingInterval)
+	}
+}
