+	if de.bestAddr.epAddr.ap != src.ap {
+		t.Fatalf("bestAddr 应指向学到的源地址：%v", de.bestAddr)
+	}
+	other := epAddr{ap: netip.MustParseAddrPort("127.3.3.41:304")}
+	de.noteRecvActivity(other, now)
+	if len(de.endpointState) != 1 || de.bestAddr.epAddr.ap != src.ap {
+		t.Fatalf("已有候选时不应被覆盖：%v / %v", de.endpointState, de.bestAddr)
+	}
