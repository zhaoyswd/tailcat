+// TestTierNoteDirectCandidatePrefersLAN（#2 ②）：best 是公网（需 NAT 回环）时被私网来包地址抢过。
+func TestTierNoteDirectCandidatePrefersLAN(t *testing.T) {
+	c := newConn(t.Logf)
+	ep := tierTestEndpoint(c)
+	public := netip.MustParseAddrPort("114.242.60.128:41641")
+	lan := netip.MustParseAddrPort("192.168.3.12:41641")
+	now := mono.Now()
+
+	ep.noteDirectCandidate(epAddr{ap: public}, now)
+	if got := ep.bestAddr.ap; got != public {
+		t.Fatalf("first candidate should be adopted, got %v", got)
+	}
+	ep.noteDirectCandidate(epAddr{ap: lan}, now)
+	if got := ep.bestAddr.ap; got != lan {
+		t.Fatalf("same-LAN candidate should take over from public, got %v", got)
 	}
+	// 同类（都是私网）不抖：再来一个私网地址不抢。
+	lan2 := netip.MustParseAddrPort("192.168.3.99:41641")
+	ep.noteDirectCandidate(epAddr{ap: lan2}, now)
+	if got := ep.bestAddr.ap; got != lan {
+		t.Fatalf("same-class candidate must not flap, got %v", got)
+	}
+	// best 过期后无条件采纳（恢复路径）。
+	ep.noteDirectCandidate(epAddr{ap: lan2}, mono.Now().Add(10*time.Second))
+	if got := ep.bestAddr.ap; got != lan2 {
+		t.Fatalf("expired best should be replaced, got %v", got)
+	}
 }
