+// TestTierDerpPeerGone（#8）：PeerGone 摘掉 DERP 回退地址；TTL 到点或收到 DERP 包后恢复。
+func TestTierDerpPeerGone(t *testing.T) {
+	c := newConn(t.Logf)
+	ep := tierTestEndpoint(c)
+	home := netip.AddrPortFrom(tailcfg.DerpMagicIPAddr, 304)
+	ep.derpAddr = home
+	ep.noteDerpRouteGone(304)
+	if ep.derpAddr.IsValid() {
+		t.Fatalf("derpAddr must be cleared on PeerGone")
+	}
+	// 别的区域说不认识 → 不动（不是它的家）。
+	ep.derpAddr = home
+	ep.noteDerpRouteGone(305)
+	if !ep.derpAddr.IsValid() {
+		t.Fatalf("PeerGone from another region must not clear the home fallback")
+	}
+	// TTL 未到不恢复，到点恢复一次。
+	ep.noteDerpRouteGone(304)
+	ep.maybeRestoreDerpAddrLocked()
+	if ep.derpAddr.IsValid() {
+		t.Fatalf("must not restore before the retry interval")
+	}
+	ep.derpGoneAt = time.Now().Add(-2 * tierDerpRetryAfter)
+	ep.maybeRestoreDerpAddrLocked()
+	if ep.derpAddr != home {
+		t.Fatalf("derpAddr = %v, want %v", ep.derpAddr, home)
+	}
+	// 收到对端经 DERP 发来的包 → 立即恢复。
+	ep.noteDerpRouteGone(304)
+	ep.noteDerpRouteBack(304)
+	if ep.derpAddr != home {
+		t.Fatalf("derpAddr = %v, want %v via noteDerpRouteBack", ep.derpAddr, home)
+	}
+}
