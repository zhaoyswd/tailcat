+// 候选非空时不得覆盖既有候选。
+func TestTierRoamingLearn(t *testing.T) {
+	c := &Conn{logf: t.Logf}
+	de := &endpoint{c: c, endpointState: map[netip.AddrPort]*endpointState{}}
+	src := epAddr{ap: netip.MustParseAddrPort("127.3.3.40:304")}
+	now := mono.Now()
+	de.noteRecvActivity(src, now)
+	if len(de.endpointState) != 1 {
+		t.Fatalf("空候选时应学习源地址：endpointState=%v", de.endpointState)
