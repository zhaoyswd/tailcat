+
+// provisionalNodeID returns a node ID for a synthesized endpoint. It must be
+// non-zero ([peerMap.upsertEndpoint] rejects zero) and must not collide with
+// the small IDs a control plane hands out, so it lives in a high range derived
+// from the node key.
+func provisionalNodeID(pubKey key.NodePublic) tailcfg.NodeID {
+	raw := pubKey.Raw32()
+	var v uint64
+	for i := 0; i < 8; i++ {
+		v = v<<8 | uint64(raw[i])
+	}
+	return tailcfg.NodeID(v>>16) | (tailcfg.NodeID(1) << 62)
+}
