+// PATCH(tier): bounds for endpoints synthesized from inbound handshakes.
+const (
+	// provisionalEndpointMax caps how many unknown-key endpoints we hold at
+	// once. At the cap, new unknown-key handshakes are dropped (the behaviour
+	// before this patch) instead of letting anyone who has the address grow
+	// the table without bound.
+	provisionalEndpointMax = 32
+
+	// provisionalEndpointIdle is how long a provisional endpoint that received
+	// no packets survives. Live peers keep refreshing it; one-shot forged
+	// handshakes age out.
+	provisionalEndpointIdle = 10 * time.Minute
