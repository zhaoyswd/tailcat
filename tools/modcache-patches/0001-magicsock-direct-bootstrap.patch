+// probeAsType is a go1.24-compatible stand-in for errors.AsType (added by this
+// project's OHOS porting script; the App core builds with go1.24.5).
+func probeAsType[E error](err error) (e E, ok bool) {
+	for cur := err; cur != nil; {
+		if e, ok = cur.(E); ok {
+			return e, true
+		}
+		switch x := cur.(type) {
+		case interface{ Unwrap() error }:
+			cur = x.Unwrap()
+		case interface{ Unwrap() []error }:
+			if l := x.Unwrap(); len(l) > 0 {
+				cur = l[0]
+			} else {
+				return e, false
+			}
+		default:
+			return e, false
+		}
+	}
+	return e, false
+}
