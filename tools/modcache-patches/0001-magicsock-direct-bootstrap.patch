+// TestTierBootstrapLogThrottle（#6）：同址 5s 内只打一条，抑制计数附在下一条上。
+func TestTierBootstrapLogThrottle(t *testing.T) {
+	var lines []string
+	c := newConn(func(format string, args ...any) { lines = append(lines, format) })
+	ep := tierTestEndpoint(c)
+	ap := netip.MustParseAddrPort("192.168.3.12:41641")
+	for i := 0; i < 100; i++ {
+		ep.logBootstrapSendLocked(ap, true, 11)
+	}
+	if len(lines) != 1 {
+		t.Fatalf("expected 1 line, got %d", len(lines))
+	}
+	if ep.bootstrapLogSuppressed != 99 {
+		t.Fatalf("suppressed = %d, want 99", ep.bootstrapLogSuppressed)
+	}
+	other := netip.MustParseAddrPort("192.168.3.13:41641")
+	ep.logBootstrapSendLocked(other, false, 11)
+	if len(lines) != 2 {
+		t.Fatalf("address change must log immediately, got %d lines", len(lines))
+	}
+	if ep.bootstrapLogSuppressed != 0 {
+		t.Fatalf("suppressed counter must reset after printing, got %d", ep.bootstrapLogSuppressed)
+	}
+}
