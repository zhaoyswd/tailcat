+// PATCH(tier #3): noteSendFailure records a failed send to a direct candidate
+// and demotes it once it has failed tierSendFailLimit times in a row.
+//
+// Without a control plane magicsock treats every candidate as potentially
+// reachable and keeps probing it: on-device the exit pinged a dead LAN address of
+// the phone (192.168.3.54:52085, `sendto: no route to host`) every 5s for 8
+// minutes (320+ log lines) while bestAddr kept pointing at it. The judgement here
+// is deliberately errno-free: any send error from the direct path counts, so it
+// also works on platforms where [isBadEndpointErr] has no EHOSTUNREACH to match.
+//
+// Runtime-learned candidates (lastGotPing/callMeMaybeTime non-zero) are dropped
+// outright — the peer re-learns them by sending us a packet, and DERP stays as
+// the fallback. Network-map candidates cannot be dropped; they get a ping backoff
+// instead. Either way the candidate stops being the best address.
+func (de *endpoint) noteSendFailure(ap netip.AddrPort) {
+	de.mu.Lock()
+	defer de.mu.Unlock()
+	de.noteSendFailureLocked(ap)
+}
+
+// noteSendFailureLocked is [endpoint.noteSendFailure] with de.mu held.
+//
+// de.mu must be held.
+func (de *endpoint) noteSendFailureLocked(ap netip.AddrPort) {
+	st, ok := de.endpointState[ap]
+	if !ok {
+		return
+	}
+	st.sendFails++
+	st.lastFailAt = time.Now()
+	if de.bestAddr.ap == ap {
+		// 下一次发送重新选路；否则会一直往这条发不出去的路重试。
+		de.clearBestAddrLocked()
+	}
+	if st.sendFails < tierSendFailLimit {
