+// SetBootstrapCandidates enables using known candidate endpoints as a UDP
+// destination before any path has been verified, so the first WireGuard
+// handshake can go direct instead of being relayed through DERP. Candidates
+// come from the caller (for tailcat: endpoint hints carried in the address and
+// endpoints learned from previous sessions). DERP is still used when it is
+// reachable; this only removes the requirement that it be reachable before a
+// direct path can be attempted. Defaults to false.
+func (c *Conn) SetBootstrapCandidates(v bool) {
+	c.bootstrapCandidates.Store(v)
