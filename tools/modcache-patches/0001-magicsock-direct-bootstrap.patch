+		// 信息：把这种伪地址写进候选 / best 会把出站流量送去一个不存在的路径。
+		return
+	}
+	de.mu.Lock()
+	defer de.mu.Unlock()
+	if st, ok := de.endpointState[src.ap]; ok {
+		if !st.lastGotPing.IsZero() {
+			st.lastGotPing = time.Now()
+		}
+		// PATCH(tier #3): 这个地址刚有包进来 = 它显然能收（发送失败记账清零）。
+		st.sendFails = 0
+	} else if len(de.endpointState) >= tierLearnedEndpointMax {
+		return
+	} else {
+		de.endpointState[src.ap] = &endpointState{lastGotPing: time.Now()}
+		de.c.logf("magicsock: 为 peer %v 登记收到包的源地址 %v 作直连候选（候选数 %d）",
+			de.publicKey.ShortString(), src.ap, len(de.endpointState))
+	}
+	// 收到包的地址就是「响应该回去的地方」。但**不能无条件**抢过 best（#2）：
+	// 双端都会把对端的公网地址学成候选，同 LAN 场景下那个地址要 NAT 回环才通
+	//（家用路由器普遍不回环），无条件采纳会让 best 落在一条发不出去的路径上 ——
+	// 真机 2026-09-18 08:30：手机与 Mac 出口同在家网段，双端 best 都落在公网
+	// 地址上，握手响应进不了 LAN，隧道一直挂中继，用户视角「没有恢复直连」。
+	//
+	// 采纳判据（其余情况保持 best 不动，避免同一 peer 多路径来回抖）：
+	//   ① best 无效 / 已过信任窗 → 采纳（恢复路径，语义与上一版一致）；
+	//   ② 新地址不需要 NAT 回环（私网/回环/链路本地）而当前 best 需要 → 采纳
+	//      （同 LAN 优先）；
+	//   ③ 当前 best 的候选已经 2s 没有收到过包（lastGotPing 陈旧）→ 采纳
+	//      （对端换地址/换网时及时跟随，与 WireGuard roaming 语义一致）。
+	switch {
+	case !de.bestAddr.ap.IsValid() || now.After(de.trustBestAddrUntil):
+	case !tierNoHairpinAddr(de.bestAddr.ap) && tierNoHairpinAddr(src.ap):
+	case tierBestRecvStale(de.endpointState, de.bestAddr.ap, time.Now()):
+	default:
+		return
+	}
+	de.setBestAddrLocked(addrQuality{epAddr: src})
+	de.bestAddrAt = now
+	de.trustBestAddrUntil = now.Add(5 * time.Second)
+}
