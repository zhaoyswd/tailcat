+// TestTierNoteDirectCandidateStaleBest（#2 ③）：best 的候选 2s 没再收到包 → 切到刚收到包的地址。
+func TestTierNoteDirectCandidateStaleBest(t *testing.T) {
+	c := newConn(t.Logf)
+	ep := tierTestEndpoint(c)
+	a := netip.MustParseAddrPort("100.64.0.9:1234")
+	b := netip.MustParseAddrPort("100.64.0.10:1234")
+	now := mono.Now()
+	ep.noteDirectCandidate(epAddr{ap: a}, now)
+	ep.endpointState[a].lastGotPing = time.Now().Add(-5 * time.Second)
+	ep.noteDirectCandidate(epAddr{ap: b}, now)
+	if got := ep.bestAddr.ap; got != b {
+		t.Fatalf("stale best should be replaced, got %v", got)
+	}
+}
