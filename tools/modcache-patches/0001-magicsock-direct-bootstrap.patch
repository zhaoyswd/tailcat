+// TestTierSendFailureDropsRuntimeCandidate（#3）：连续发送失败到阈值 → 运行时学来的候选被摘除、best 清空。
+func TestTierSendFailureDropsRuntimeCandidate(t *testing.T) {
+	c := newConn(t.Logf)
+	ep := tierTestEndpoint(c)
+	pub := netip.MustParseAddrPort("114.242.60.128:41641")
+	live := netip.MustParseAddrPort("192.168.3.56:52085")
+	now := mono.Now()
+	ep.noteDirectCandidate(epAddr{ap: pub}, now)
+	ep.noteDirectCandidate(epAddr{ap: live}, now) // 同 LAN 优先：抢过公网 best
+	if ep.bestAddr.ap != live {
+		t.Fatalf("best = %v, want %v", ep.bestAddr.ap, live)
+	}
+	for i := 0; i < tierSendFailLimit; i++ {
+		ep.noteSendFailure(live)
+	}
+	if _, ok := ep.endpointState[live]; ok {
+		t.Fatalf("runtime-learned candidate must be dropped after %d send failures", tierSendFailLimit)
+	}
+	if ep.bestAddr.ap.IsValid() {
+		t.Fatalf("bestAddr must be cleared, got %v", ep.bestAddr.ap)
+	}
+	if _, ok := ep.endpointState[pub]; !ok {
+		t.Fatalf("other candidates must survive")
+	}
+}
