+// adoptProvisionalEndpointLocked turns a provisional endpoint (synthesized
+// from a direct handshake, see upsertProvisionalEndpointLocked) into the
+// network map's version of that peer, **in place**.
+//
+// Why in place: the WireGuard device pins the endpoint object it was given when
+// the peer was created (lazily, via [Conn.ParseEndpoint]) and never roams to a
+// different object. Replacing the object (delete + create) therefore leaves
+// the device sending handshake responses and data through an orphaned endpoint
+// that can no longer learn anything: with no control plane the *received*
+// packets are the only source of path knowledge, and after the swap those go to
+// the new object. The orphaned one keeps its stale candidate list — or, once
+// the session expires, none at all — and the tunnel stays up while every
+// self-dialed connection through it dies.
+//
+// The network map is still authoritative for everything it carries (node ID,
+// disco key, DERP home, endpoints, WireGuard-only-ness): the caller runs the
+// ordinary update path on the same object right after.
+//
+// c.mu must be held.
+func (c *Conn) adoptProvisionalEndpointLocked(ep *endpoint, n tailcfg.NodeView) {
+	oldID := ep.nodeID
+	ep.nodeID = n.ID()
+	ep.provisional = false
+	ep.isWireguardOnly = n.IsWireGuardOnly()
+	delete(c.provisionalPeers, ep.publicKey)
+	if n.Addresses().Len() > 0 {
+		ep.nodeAddr = n.Addresses().At(0).Addr()
+	}
+	// The TSMP marker was a provisional-phase placeholder ("no control disco
+	// key known yet"). The network map brings the peer's real disco key, so
+	// drop it: [endpoint.updateDiscoKey] keeps a set tsmpActive flag sticky,
+	// and a peer with an active TSMP key would have disco sent to the empty
+	// TSMP key instead of the peer's real one.
+	ep.disco.Store(&endpointDisco{})
+	c.peerMap.rekeyEndpointLocked(ep, oldID)
+	c.logf("magicsock: provisional peer %v adopted by the network map in place (nodeID %v→%v, wgonly=%v, candidates=%d)",
+		ep.publicKey.ShortString(), oldID, ep.nodeID, ep.isWireguardOnly, len(ep.endpointState))
